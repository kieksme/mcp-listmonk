{
  "name": "@kieksme/listmonk-mcp",
  "mcpName": "io.github.kieksme/listmonk-mcp",
  "version": "1.3.0",
  "description": "MCP server for the Listmonk newsletter/mailing-list API — stdio for local clients, Streamable HTTP for remote deployments",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "listmonk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/mcp-listmonk.git"
  },
  "homepage": "https://github.com/kieksme/mcp-listmonk#readme",
  "bugs": {
    "url": "https://github.com/kieksme/mcp-listmonk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "listmonk",
    "newsletter",
    "email",
    "mailing-list"
  ],
  "author": "kieksme GbR",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "list-tools": "tsx scripts/list-tools.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@kieksme/mcp-http-kit": "^0.4.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "axios": "1.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@opentelemetry/semantic-conventions": "1.43.0",
      "import-in-the-middle": "3.5.2",
      "follow-redirects": "1.16.1"
    }
  }
}
